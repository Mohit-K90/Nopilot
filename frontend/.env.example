# All optional. Leave empty in development: requests go to the Vite dev server, which proxies them.
# Set these when the frontend is served separately from the APIs (they must then allow CORS),
# or set VITE_API_URL to a single API Gateway URL.
VITE_API_URL=
VITE_USER_API_URL=
VITE_REPO_API_URL=
VITE_AI_API_URL=

# Dev-server proxy targets (only used by `npm run dev` / `npm run preview`)
DEV_USER_SERVICE_URL=http://localhost:8081
DEV_REPOSITORY_SERVICE_URL=http://localhost:8082
DEV_AI_SERVICE_URL=http://localhost:8083
